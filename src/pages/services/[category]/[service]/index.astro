---
import { serviceCategories, getCategoryBySlug } from '../../../../data/services';
import Layout from '../../../../layouts/Layout.astro';
import { contactInfo } from '../../../../data/contact';

export function getStaticPaths() {
  return serviceCategories.flatMap((category) =>
    category.services.map((service) => ({
      params: { category: category.slug, service: service.slug },
      props: { category, service },
    }))
  );
}

const { category, service } = Astro.props;

const siteUrl = 'https://vitriersparis.fr';

// Truncate description to ~155 chars for meta
const metaDescription = service.description.length > 158
  ? service.description.slice(0, 155).replace(/\s+\S*$/, '') + '...'
  : service.description;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/services/` },
    { "@type": "ListItem", "position": 3, "name": category.name, "item": `${siteUrl}/services/${category.slug}/` },
    { "@type": "ListItem", "position": 4, "name": service.title, "item": `${siteUrl}/services/${category.slug}/${service.slug}/` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": service.title,
  "name": service.title,
  "description": service.description,
  "provider": { "@id": `${siteUrl}/#organization` },
  "areaServed": { "@type": "State", "name": "Île-de-France" },
  "url": `${siteUrl}/services/${category.slug}/${service.slug}/`,
  "offers": {
    "@type": "Offer",
    "price": service.price.replace(/[^0-9]/g, '') || undefined,
    "priceCurrency": "EUR",
    "priceSpecification": {
      "@type": "PriceSpecification",
      "price": service.price,
      "priceCurrency": "EUR"
    },
    "availability": "https://schema.org/InStock",
    "seller": { "@id": `${siteUrl}/#organization` }
  }
};

const relatedServices = category.services.filter(s => s.slug !== service.slug).slice(0, 3);
---

<Layout
  title={`${service.title} — ${category.name} Paris IDF | ${contactInfo.companyName}`}
  description={metaDescription}
  canonical={`/services/${category.slug}/${service.slug}/`}
  jsonLd={[breadcrumbSchema, serviceSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700 via-primary-800 to-[#1A2B4A]"></div>
    <img
      src={service.image}
      alt={service.title}
      class="absolute inset-0 w-full h-full object-cover opacity-15"
      width="800"
      height="500"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700/80 via-primary-800/85 to-[#1A2B4A]/95"></div>

    <div class="relative container-custom section-padding !py-16 md:!py-24">
      <div class="max-w-3xl">
        <nav class="flex items-center gap-2 text-sm text-primary-200 mb-6 flex-wrap" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href="/services/" class="hover:text-white transition-colors">Services</a>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href={`/services/${category.slug}/`} class="hover:text-white transition-colors">{category.name}</a>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white">{service.title}</span>
        </nav>

        <div class="flex items-center gap-3 mb-4">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-white/15 border border-white/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.iconPath} />
            </svg>
          </div>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-500/20 text-accent-300 rounded-full text-sm font-semibold border border-accent-500/30">
            {service.price}
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-6">{service.title}</h1>

        <p class="text-lg text-primary-100 leading-relaxed mb-8">
          {service.description.split('. ').slice(0, 2).join('. ')}.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={contactInfo.phoneHref} class="btn-accent !py-3.5 shadow-xl shadow-accent-500/15">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            {contactInfo.phone}
          </a>
          <a href={contactInfo.whatsapp} target="_blank" rel="noopener" class="btn-whatsapp !py-3.5 shadow-xl shadow-green-700/15">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail content -->
  <section class="section-padding bg-[#F0F4F8]">
    <div class="container-custom">
      <div class="grid lg:grid-cols-3 gap-10">
        <!-- Main content (2/3) -->
        <article class="lg:col-span-2">
          <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-[#DFE6EE]">
            <h2 class="text-2xl md:text-3xl font-bold text-[#1A2B4A] mb-6">Détail de la prestation</h2>
            <div class="prose prose-slate max-w-none">
              <p class="text-slate-700 leading-relaxed text-base md:text-lg">
                {service.description}
              </p>
            </div>

            <div class="mt-8 pt-8 border-t border-[#DFE6EE]">
              <h3 class="text-xl font-bold text-[#1A2B4A] mb-4">Zones d'intervention</h3>
              <p class="text-slate-600 leading-relaxed">
                Nous intervenons sur tous les arrondissements de <strong>Paris (75)</strong> ainsi que dans
                les départements <strong>77, 78, 91, 92, 93, 94 et 95</strong>. Pour les urgences,
                notre temps d'intervention moyen est de moins d'1 heure sur Paris et 2 heures
                en Île-de-France.
              </p>
            </div>
          </div>

          <!-- Related services -->
          {relatedServices.length > 0 && (
            <div class="mt-10">
              <h2 class="text-2xl font-bold text-[#1A2B4A] mb-6">Autres prestations en {category.name.toLowerCase()}</h2>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {relatedServices.map((s) => (
                  <a href={`/services/${category.slug}/${s.slug}/`} class="block bg-white rounded-xl p-5 border border-[#DFE6EE] hover-lift transition-all">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 border border-primary-100 flex items-center justify-center mb-3">
                      <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.iconPath} />
                      </svg>
                    </div>
                    <h3 class="text-base font-bold text-[#1A2B4A] mb-2">{s.title}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">{s.description.slice(0, 100)}...</p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </article>

        <!-- Sidebar (1/3) -->
        <aside class="space-y-6">
          <!-- Price block -->
          <div class="bg-white rounded-2xl p-6 border border-[#DFE6EE] shadow-sm">
            <div class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Tarif</div>
            <div class="text-3xl font-black text-accent-600 mb-2">{service.price}</div>
            <p class="text-sm text-slate-600 mb-4">Devis gratuit, sans engagement. Tarif détaillé après diagnostic.</p>
            <a href={contactInfo.phoneHref} class="btn-accent w-full !py-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Demander un devis
            </a>
          </div>

          <!-- Trust badges -->
          <div class="bg-white rounded-2xl p-6 border border-[#DFE6EE] shadow-sm">
            <h3 class="font-bold text-[#1A2B4A] mb-4">Nos engagements</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Intervention en moins d'1h sur Paris</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Devis gratuit, sans engagement</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Garantie décennale incluse</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Agréé compagnies d'assurance</span>
              </li>
            </ul>
          </div>

          <!-- Back to category -->
          <a href={`/services/${category.slug}/`} class="block bg-primary-50 border border-primary-200 rounded-2xl p-6 hover:bg-primary-100 transition-colors">
            <div class="text-xs font-semibold text-primary-600 uppercase tracking-wide mb-2">← Catégorie</div>
            <div class="font-bold text-[#1A2B4A]">{category.name}</div>
            <p class="text-sm text-slate-600 mt-1">Voir tous les services de cette catégorie</p>
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-gradient-to-r from-primary-800 via-primary-700 to-primary-800 border-y border-primary-600/20">
    <div class="container-custom px-4 md:px-6 lg:px-8 py-12 md:py-16">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 max-w-5xl mx-auto">
        <div class="text-center md:text-left">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Besoin d'un devis pour {service.title.toLowerCase()} ?</h2>
          <p class="text-primary-200">Réponse rapide, devis détaillé, intervention soignée.</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a href={contactInfo.phoneHref} class="btn-accent !py-3.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            {contactInfo.phone}
          </a>
          <a href={contactInfo.whatsapp} target="_blank" rel="noopener" class="btn-whatsapp !py-3.5">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
